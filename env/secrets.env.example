# Copied to ../secrets/secrets.env by scripts/gen-secrets.sh. NEVER commit the filled copy.
#
# gen-secrets.sh fills the generated half and never rewrites a value that is
# already set. versalife-ansible writes the rest (Cloudflare Access, TURN, CORS,
# SMS/email/PayHere, the test secret) from its vault.

# --- generated: database -----------------------------------------------------
# docker-compose.yml interpolates both, so they must also be in ../.env.
POSTGRES_PASSWORD=
TELEMED_API_DB_PASSWORD=

# --- generated: application keys ---------------------------------------------
Auth__Jwt__SigningKey=
Otp__HmacKey=
Storage__SigningKey=
Video__RoomTokenKey=
# Standard base64 of exactly 32 bytes. Rotating it orphans every stored bank account number.
Crypto__BankDataKey=
# Rotating it invalidates the QR code on every prescription already issued.
Prescriptions__HmacKey=

# --- from versalife-ansible --------------------------------------------------
# Deliberately NOT listed as empty keys: an empty entry such as
# `Cors__Origins__1=` is still an array element, and the API refuses to start
# on it. versalife-ansible appends:
#
#   AdminAuth__CloudflareAccess__{TeamDomain,Audience}, AdminAuth__BootstrapSuperAdminEmail,
#   AdminAuth__IpAllowlist__<n>, Cors__Origins__<n>, Cors__AdminOrigins__0,
#   AppLinks__PatientAppUrl, Prescriptions__VerifyBaseUrl, Turn__Cloudflare__{KeyId,ApiToken},
#   Testing__SharedSecret, Sms__*, Email__*, Payments__PayHere__*
