# Copy to ../secrets/secrets.env and fill in. NEVER commit the filled copy.
#
# Generate the machine-generated half with:
#   ./scripts/gen-secrets.sh
#
# It is idempotent: it only fills what is missing, and never rewrites
# NIC_HASH_PEPPER or PRESCRIPTION_HMAC_SECRET, because rotating those is a
# data-migration event and not a config change.

# --- infrastructure passwords (generated) ------------------------------------
POSTGRES_PASSWORD=
TELEMED_MIGRATOR_PASSWORD=
# ONE password for all eight telemed_<domain>_app roles. dsnResolver takes the
# password from DATABASE_URL and swaps only the username, so eight different
# passwords would need eight DSNs.
TELEMED_APP_DB_PASSWORD=
REDIS_PASSWORD=
NATS_PASSWORD=
# NATS credentials travel IN the URL -- events.NewNATS has no separate password
# setting -- which is why this lives here and not in env/common.env.
NATS_URL=nats://telemed:CHANGEME@nats:4222

# Must carry TELEMED_APP_DB_PASSWORD and name any one app role; cmd/telemed
# rewrites the username per domain.
DATABASE_URL=postgres://telemed_user_app:CHANGEME@postgres:5432/telemed?sslmode=disable

# --- application secrets (generated) -----------------------------------------
# RSA private key for the tokens user-service mints. MULTILINE: it cannot live
# in an env_file, which has no line-continuation syntax -- a truncated value
# makes the user domain silently fall back to an ephemeral key and every
# session dies on every deploy, with no error anywhere. gen-secrets.sh writes
# it to secrets/jwt-key.pem and emits secrets/secrets.override.yml, a compose
# override using a YAML block scalar. See the script.
JWT_PRIVATE_KEY_PEM=

# Peppers the NIC hash. Rotating it orphans every hashed NIC on the platform;
# NIC_HASH_PEPPER_PREVIOUS exists for the overlap window.
NIC_HASH_PEPPER=
NIC_HASH_PEPPER_VERSION=1
NIC_HASH_PEPPER_PREVIOUS=

# NaCl secretbox key for doctor bank details. Exactly 32 bytes, STANDARD
# base64 with padding -- `openssl rand -base64 32`, verbatim.
#
# Not the URL-safe alphabet the passwords above use. crypto.go decodes this
# with base64.StdEncoding, which rejects `-` and `_`; the doctor domain then
# dies at boot with "illegal base64 data at input byte 40".
BANK_ENCRYPTION_KEY=

# Signs the QR on every e-prescription. Rotating it invalidates every
# prescription already issued.
PRESCRIPTION_HMAC_SECRET=

# Keys the HMAC on filesystem presigned URLs. Must be IDENTICAL in all three
# containers: telemed-backend serves /api/v1/files, and telemed-video and
# telemed-notification would otherwise mint URLs it refuses.
FILESYSTEM_PRESIGN_SECRET=

# Signs the short-lived room tokens the signalling websocket verifies. Unset
# means a random key per process, which breaks any deployment with more than
# one replica in a way that looks exactly like flaky networking.
SIGNAL_SECRET=

# Verifies provider delivery callbacks. At least 24 characters or the
# notification domain refuses to boot.
NOTIFICATION_WEBHOOK_SECRET=

# The mesh credential telemed-notification presents to telemed-backend's gRPC
# directory. A long-lived JWT signed by the SAME JWT_PRIVATE_KEY_PEM above and
# asserting the "service" role, so the receiving side is unchanged. Mint with:
#   docker compose run --rm -e JWT_PRIVATE_KEY_PEM="$(cat secrets/jwt-key.pem)" \
#     telemed-backend mint-service-token notification-service 8760h
MESH_STATIC_TOKEN=

# --- Cloudflare (from the dashboard) -----------------------------------------
# The bare apex; the tunnel builds api.<domain> and rtc.<domain> from it.
TELEMED_DOMAIN=example.lk
TUNNEL_ID=
# `cloudflared tunnel create` writes the credentials JSON. Put it at
# secrets/tunnel-credentials.json; it is a file, never an env var.

# Cloudflare Access is the administrator identity provider. ADMIN_ISSUER binds
# admin ROLE checks to it, which is the only thing stopping a user-service
# token from asserting super_admin.
ADMIN_ISSUER=https://YOURTEAM.cloudflareaccess.com
ADMIN_JWKS_URL=https://YOURTEAM.cloudflareaccess.com/cdn-cgi/access/certs

# Cloudflare Realtime TURN. NOT optional: most Sri Lankan mobile users are
# behind carrier-grade NAT, where STUN alone does not connect a call at all.
#
# Credentials are minted over Cloudflare's API, not by the coturn HMAC scheme
# -- so these are a TURN key id and an API token, and the TURN URLs come back
# in the API response rather than being configured here. From the dashboard:
# Realtime -> TURN.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# A second lock in front of the gateway's admin routes; Cloudflare Access is
# the first. Comma-separated CIDRs. The gateway refuses to boot in production
# with this empty.
ADMIN_IP_ALLOWLIST=

# --- public URLs -------------------------------------------------------------
PUBLIC_API_BASE_URL=https://api.example.lk
PUBLIC_APP_BASE_URL=https://patient.example.lk
DOCTOR_PORTAL_BASE_URL=https://doctor.example.lk
VERIFY_BASE_URL=https://verify.example.lk
CORS_PATIENT_ORIGINS=https://patient.example.lk
CORS_DOCTOR_ORIGINS=https://doctor.example.lk
CORS_ADMIN_ORIGINS=https://admin.example.lk

# --- third-party rails (from each provider) ----------------------------------
DIALOG_APPLICATION_ID=
DIALOG_PASSWORD=
DIALOG_SOURCE_ADDRESS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
DIALOG_PAY_APPLICATION_ID=
DIALOG_PAY_PASSWORD=
DIALOG_PAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.lk
FCM_PROJECT_ID=

# --- volumes -----------------------------------------------------------------
DATA_VOLUME=/mnt/data
OBJECTS_VOLUME=/mnt/objects
