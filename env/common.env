# Shared, non-secret configuration for all three application containers.
#
# Committed on purpose: nothing here is a secret. Secrets live in
# secrets/secrets.env, which is generated by scripts/gen-secrets.sh and
# gitignored. Both are loaded by every application container, secrets last.

ENV=production
LOG_LEVEL=info
TIMEZONE=Asia/Colombo
SHUTDOWN_GRACE=20s
REQUEST_TIMEOUT=65s

# --- datastores (compose DNS names, never localhost) -------------------------
# The password halves come from secrets.env as REDIS_PASSWORD / NATS_PASSWORD;
# these URLs deliberately carry no credentials of their own.
REDIS_URL=redis://redis:6379
REDIS_DB=0
# NATS_URL is in secrets.env: NATS credentials travel in the URL itself.
NATS_STREAM=TELEMED

# 1 GiB, comfortably under nats.conf's max_file_store of 4GB, and IDENTICAL in
# all three containers. events.NewNATS creates the TELEMED stream with this
# value on every boot, last writer wins, and JetStream refuses stream creation
# outright when MaxBytes exceeds max_file_store.
NATS_MAX_BYTES=1073741824

OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100

# --- database ----------------------------------------------------------------
# DATABASE_URL is in secrets.env: it carries the password. cmd/telemed derives
# a per-domain DSN from it, swapping in telemed_<domain>_app and pinning
# search_path to svc_<domain>.
#
# ONE pool per domain, this many connections each. With six domains in
# telemed-backend and one in each of the other two, peak is 32 against
# postgresql.conf's max_connections=50.
#
# Note DATABASE_MAX_CONNS and DATABASE_MIN_CONNS are NOT the knob -- they are
# parsed into config.Base and read by nothing. Setting them does nothing.
DB_MAX_CONNS_PER_DOMAIN=4
DATABASE_MAX_CONN_LIFE=1h

# --- identity ----------------------------------------------------------------
# Two issuers. user-service mints patient and doctor tokens; Cloudflare Access
# mints administrator tokens. ADMIN_ISSUER binds admin ROLE checks to the
# second, which is what stops user-service -- which can put super_admin in a
# token it honestly signs -- from asserting one.
#
# ADMIN_ISSUER and ADMIN_JWKS_URL are set in secrets.env alongside the team
# name they contain.
USER_ISSUER=telemed-user-service
USER_JWKS_URL=http://telemed-backend:8080/.well-known/jwks.json
JWT_ISSUER=telemed-user-service
JWT_AUDIENCE=telemed-api
JWT_KEY_ID=user-service-key-1

# Keycloak stays in the code and stays off. Empty issuer means the gateway
# falls through to ADMIN_ISSUER; setting these would re-enable a second admin
# issuer nobody is running.
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URL=
KEYCLOAK_BASE_URL=

# --- edge --------------------------------------------------------------------
# TRUSTED_PROXIES is deliberately EMPTY. middleware.ClientIP trusts
# X-Forwarded-For only from a peer in a private range, and cloudflared sits on
# a 172.x bridge -- so the real client IP already reaches the rate limiter,
# the admin allowlist and the audit log. Setting 0.0.0.0/0 here is the
# spoofing hole the code's own comment warns about.
TRUSTED_PROXIES=

MAX_IN_FLIGHT=2000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=30
CIRCUIT_PROBE_SECONDS=5
MAX_BODY_BYTES_FAST=1048576
MAX_BODY_BYTES_WRITE=4194304
MAX_BODY_BYTES_UPLOAD=15728640

# All eight upstreams must be non-empty or the gateway refuses to boot, even
# for domains it resolves in-process. The six self-pointing entries are never
# dialled; the two that name another container are real network hops.
UPSTREAM_USER_URL=http://127.0.0.1:8080
UPSTREAM_DOCTOR_URL=http://127.0.0.1:8080
UPSTREAM_SCHEDULING_URL=http://127.0.0.1:8080
UPSTREAM_PAYMENT_URL=http://127.0.0.1:8080
UPSTREAM_RECORD_URL=http://127.0.0.1:8080
UPSTREAM_ADMIN_URL=http://127.0.0.1:8080
UPSTREAM_CONSULTATION_URL=http://telemed-video:8080
UPSTREAM_NOTIFICATION_URL=http://telemed-notification:8080

# --- object storage ----------------------------------------------------------
# Filesystem, not MinIO: a MinIO container costs 300-500 MB of a 4 GB box, and
# the presigned URLs here are real HMAC-signed capabilities served by
# /api/v1/files. FILESYSTEM_PRESIGN_SECRET is in secrets.env and MUST be
# identical in every container that mints or serves one.
STORAGE_BACKEND=filesystem
FILESYSTEM_STORAGE_DIR=/data/objects

# --- video -------------------------------------------------------------------
# In-house 1:1 signalling. LiveKit stays compiled and dormant; setting
# VIDEO_PROVIDER=livekit and the LIVEKIT_* keys switches back.
VIDEO_PROVIDER=inhouse

# Where the browser opens the signalling websocket. ABSOLUTE and wss://, and
# the backend refuses to boot in production otherwise: the browser connects
# directly (a Next route handler cannot proxy an upgrade) so it has nothing to
# resolve a relative path against, and the room token travels in the query
# string.
#
# rtc., not api.: the tunnel routes it straight to telemed-video, bypassing the
# gateway whose shortest timeout class would cut every consultation at five
# seconds.
SIGNAL_PUBLIC_URL=wss://rtc.example.lk/ws/consultation

# Must outlast a consultation. Unlike an SFU access token, which is spent once
# at connect, this one is re-presented on EVERY websocket reconnect -- so a
# five-minute value strands any client that changes network mid-call.
SIGNAL_TOKEN_TTL=2h

# CORS does not apply to a websocket handshake, so the Origin check is the only
# origin control the socket has. Defaults to CORS_PATIENT_ORIGINS +
# CORS_DOCTOR_ORIGINS when unset; production refuses to boot if the result is
# empty.
SIGNAL_ALLOWED_ORIGINS=

# TURN. "cloudflare" mints credentials from Cloudflare Realtime TURN over its
# API; "static" is the coturn HMAC scheme (ICE_TURN_SECRET) or a fixed
# username/password pair. Cloudflare does NOT implement the coturn REST scheme,
# so ICE_TURN_SECRET does nothing in cloudflare mode.
ICE_TURN_MODE=cloudflare
ICE_STUN_URLS=stun:stun.cloudflare.com:3478
ICE_TURN_TTL=12h

# The stale sweeper is now the MECHANISM that ends an abandoned call, not a
# backstop behind an SFU's room_finished webhook -- there is no webhook any
# more. Two hours was chosen so it could never race LiveKit's own teardown;
# with nothing to race it just means an abandoned consultation stays "active"
# for two hours, so scheduling never settles the appointment and
# record-service never learns when care ended.
#
# Ten minutes is safe here ONLY because the occupancy lease makes
# ListParticipants accurate to about half a minute: that call is the sole
# thing standing between this sweeper and ending live consultations. Do not
# lower STALE_IDLE_TIMEOUT further without re-reading occupancyTTL.
STALE_SWEEP_INTERVAL=1m
STALE_IDLE_TIMEOUT=10m
STALE_SWEEP_BATCH=50

# --- notification ------------------------------------------------------------
# The one synchronous cross-service call: recipient contact lookup over gRPC.
# Plaintext, on the internal `data` bridge which has no route off the host.
USER_SERVICE_GRPC_ADDR=telemed-backend:9091
USER_SERVICE_GRPC_TLS=false
USER_SERVICE_GRPC_ALLOW_PLAINTEXT=true
USER_LOOKUP_TIMEOUT_SECONDS=3

# No SMS rail and no FCM project, so both channels say so explicitly rather
# than being left on "direct" (which fails at boot on the first missing
# credential) or on "console" (which is refused in production because it
# reports every send delivered while printing the recipient and body to the
# log stream).
#
# email: sms-channel messages are delivered to the recipient's EMAIL address.
# The channel keeps its identity -- templates, preferences and quiet hours all
# still say "sms" -- but a user with no email on file has no reachable sms
# channel. Set this back to "direct" once DIALOG_* is arranged.
NOTIFICATION_SMS_PROVIDER=email
NOTIFICATION_SMS_BACKEND=dialog
NOTIFICATION_EMAIL_PROVIDER=direct
# disabled: every push send fails permanently and lands in dead-letter where
# it can be seen, instead of the service refusing to boot over a missing FCM
# service account. Set back to "direct" once FCM_* is arranged.
NOTIFICATION_PUSH_PROVIDER=disabled
DISPATCH_INTERVAL_SECONDS=2
DISPATCH_BATCH_SIZE=50
REMINDER_INTERVAL_SECONDS=60
MAINTENANCE_INTERVAL_HOURS=24
NOTIFICATION_BODY_RETENTION_DAYS=90
DEVICE_TOKEN_RETENTION_DAYS=30
MAX_SEND_ATTEMPTS=6

# --- removed dependencies ----------------------------------------------------
# Deliberately absent rather than set empty, so nobody tunes a key nothing
# reads: OTLP_ENDPOINT, CLAMAV_ADDR, MINIO_*, LIVEKIT_*, KEYCLOAK_ADMIN_*,
# DATABASE_MAX_CONNS, DATABASE_MIN_CONNS.
