# Shared, non-secret configuration for telemed-api.
#
# Committed on purpose: nothing here is a secret. Secrets and host-specific
# values live in secrets/secrets.env (generated by scripts/gen-secrets.sh and
# filled by versalife-ansible), which is loaded after this file and wins.
# Keys use `__` for the `:` in the API's configuration sections; the full list
# is in telemed-api's README.

ASPNETCORE_ENVIRONMENT=Production
# Workstation GC: the server GC reserves a heap per core, which this box cannot spare.
DOTNET_gcServer=0

# One instance, so applying EF migrations at startup cannot race another
# replica. scripts/deploy.sh dumps the database before every deploy.
Database__MigrateOnStartup=true

Storage__RootPath=/var/lib/telemed/files

# The origin is reachable only through the Cloudflare tunnel, so CF-Connecting-IP
# is the real client address for rate limits, the admin allowlist and the audit log.
ForwardedHeaders__TrustCloudflare=true

AdminAuth__CloudflareAccess__Enabled=true

Turn__Provider=Cloudflare

Email__FromName=VersaLife

# --- test switches -----------------------------------------------------------
# Listed in the API's startup warning banner. On while the platform is
# pre-launch: captured SMS/email are readable at /api/v1/test/captured-messages
# (X-Test-Secret required), and the mock payment rail settles bookings.
Testing__CaptureInbox__Enabled=true
Testing__InstantMeetings__Enabled=true
Payments__Mock__Enabled=true
