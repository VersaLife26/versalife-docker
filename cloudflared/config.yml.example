# Cloudflare Tunnel ingress.
#
# =============================================================================
# ORDER IS THE SECURITY MODEL
# =============================================================================
# cloudflared takes the FIRST matching rule. Every deny must therefore precede
# the catch-all it is denying against. Moving a rule below the hostname rule
# that follows it silently disables it.

tunnel: ${TUNNEL_ID}
credentials-file: /etc/cloudflared/credentials.json
metrics: 127.0.0.1:2000
no-autoupdate: true
protocol: quic
loglevel: info

originRequest:
  connectTimeout: 10s
  tcpKeepAlive: 30s
  keepAliveTimeout: 90s
  keepAliveConnections: 32
  noHappyEyeballs: true

ingress:
  # ---------------------------------------------------------------------------
  # 1. Operational surface -- never publicly reachable.
  #
  # /health/ready names the API's dependency checks. 404 rather than 403: a
  # 403 confirms the path exists.
  # ---------------------------------------------------------------------------
  - hostname: api.${TELEMED_DOMAIN}
    path: ^/health(/.*)?$
    service: http_status:404

  # ---------------------------------------------------------------------------
  # 2. The API, including the SignalR hub at /hubs/consultation. cloudflared
  # proxies the WebSocket upgrade natively; the longer keepalive outlasts the
  # hub's own keep-alive pings.
  # /api/v1/test/* is reachable but needs X-Test-Secret.
  # ---------------------------------------------------------------------------
  - hostname: api.${TELEMED_DOMAIN}
    service: http://telemed-api:8080
    originRequest:
      keepAliveTimeout: 120s

  # ---------------------------------------------------------------------------
  # 3. Everything else.
  # ---------------------------------------------------------------------------
  - service: http_status:404
